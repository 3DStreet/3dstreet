rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isImageUnderSizeLimit() {
      return resource.size < 100 * 1024 && resource.contentType.matches('image/.*');
    }

    function sceneDoc(scene_uuid) {
      return firestore.get(/databases/(default)/documents/scenes/$(scene_uuid)).data;
    }

    function orgRole(orgId) {
      return firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOrgMember(orgId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    // Mirrors canReadScene in firestore.rules (#1267): a private scene's
    // files are its author's (personal scene) or its org members' (team
    // scene). Download-token URLs, which the app stores (e.g. imagePath),
    // bypass these rules entirely.
    function isSceneVisibleToCaller(scene_uuid) {
      let scene = sceneDoc(scene_uuid);
      let orgId = scene.get('orgId', null);
      return scene.get('visibility', 'public') != 'private'
        || (orgId == null && request.auth != null && scene.author == request.auth.uid)
        || (orgId != null && isOrgMember(orgId));
    }

    // The author of a personal scene, or an owner, admin or member of a
    // team scene's org (thumbnails, screenshots).
    function canWriteSceneFiles(scene_uuid) {
      let scene = sceneDoc(scene_uuid);
      let orgId = scene.get('orgId', null);
      return request.auth != null && (
        (orgId == null && scene.author == request.auth.uid)
        || (orgId != null && isOrgMember(orgId)
          && orgRole(orgId) in ['owner', 'admin', 'member']));
    }

    // Scene files
    match /scenes/{scene_uuid}/files/{allPaths=**} {
      allow read: if isSceneVisibleToCaller(scene_uuid)
        && (isImageUnderSizeLimit() || request.auth != null);
      allow write: if canWriteSceneFiles(scene_uuid);
    }

    // Team asset library files (#1267 Phase 4): copied here by the
    // team-assets callables (Admin SDK). Members read them; nobody writes
    // from a client. The app loads them through download-token URLs, which
    // bypass these rules.
    match /orgs/{orgId}/assets/{allPaths=**} {
      allow read: if isOrgMember(orgId);
    }

    // Seats upload new files into an asset's folder (direct upload into the
    // library, a thumbnail). Create only: an existing file is never
    // overwritten from a client. Same types and hard ceiling as personal
    // assets; the team's storage limit is the getUploadQuota preflight.
    match /orgs/{orgId}/assets/{assetId}/{fileName} {
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/orgs/$(orgId)).data.status == 'active'
        && orgRole(orgId) in ['owner', 'admin', 'member']
        && request.resource.size < 5 * 1000 * 1000 * 1000
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('model/.*')
          || request.resource.contentType.matches('application/octet-stream')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Gallery asset files storage rules (all nested paths)
    // Handles: images/, videos/, meshes/, splats/{taskId}/, etc.
    match /users/{userId}/assets/{allPaths=**} {
      // Users can read their own asset files
      allow read: if request.auth != null && request.auth.uid == userId;

      // Delete: disallowed for clients. Soft delete flips `deleted: true` on
      // the Firestore doc; actual byte purge is done by a garbage-collector
      // Cloud Function via Admin SDK (which bypasses these rules).

      // Create/update: owner-only, allowed content types, and a SINGLE flat
      // per-file hard ceiling (5 GB = the top plan's per-file cap). The per-file
      // limit is plan-scaled (FREE 100 MB / PRO 1 GB / MAX 5 GB) but that is
      // SOFT-enforced in getUploadQuota + the client (MAX_FILE_BYTES_BY_PLAN);
      // these rules only need the generous MAX backstop so the soft per-plan cap
      // is always the binding limit. Type-agnostic on size by design: a big
      // upload costs the same to host regardless of type. (Total storage quota
      // is a separate, additive limit handled by onAssetWritten.)
      // image/model/octet-stream(.ply)/video are the accepted gallery types;
      // GLB blobs usually arrive as model/gltf-binary but some clients send
      // octet-stream.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1000 * 1000 * 1000
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('model/.*')
          || request.resource.contentType.matches('application/octet-stream')
          || request.resource.contentType.matches('video/.*')
        );
    }
  }
}
