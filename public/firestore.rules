rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Scene visibility (#1267, docs/scene-visibility.md):
    //   'public'   — anyone can open it; listed in the community feed
    //   'unlisted' — anyone with the link can open it; not listed
    //   'private'  — only the author can open it
    // Docs written before the field existed are public. Clients may set
    // 'public' or 'unlisted' themselves; 'private' is a Pro feature whose
    // entitlement rules can't check (team domains live in a secret), so it
    // is only ever written by the setSceneVisibility callable (Admin SDK).
    function sceneVisibility(data) {
      return data.get('visibility', 'public');
    }

    function isSceneAuthor(data) {
      return request.auth != null && request.auth.uid == data.author;
    }

    function isClientSettableVisibility(data) {
      return !('visibility' in data) || data.visibility in ['public', 'unlisted'];
    }

    match /scenes/{scene} {
      allow get: if sceneVisibility(resource.data) != 'private'
        || isSceneAuthor(resource.data);

      // A list query must be provably limited to public scenes
      // (where visibility == 'public') or to the caller's own scenes
      // (where author == uid); an unfiltered query is refused.
      allow list: if resource.data.visibility == 'public'
        || isSceneAuthor(resource.data);

      allow create: if request.auth != null
        && request.resource.data.author == request.auth.uid
        && isClientSettableVisibility(request.resource.data);

      // The author keeps the scene (author is immutable) and can lower its
      // visibility, or leave it untouched, but never make it private.
      allow update: if isSceneAuthor(resource.data)
        && request.resource.data.author == resource.data.author
        && (sceneVisibility(request.resource.data) == sceneVisibility(resource.data)
            || isClientSettableVisibility(request.resource.data));

      allow delete: if isSceneAuthor(resource.data);
    }

    // Organizations (teams, #1267 Phase 1, docs/orgs.md). Every write goes
    // through the org callables (public/functions/orgs.js, Admin SDK).
    function orgMember(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgMember(orgId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgManager(orgId) {
      return isOrgMember(orgId) && orgMember(orgId).data.role in ['owner', 'admin'];
    }

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }
    }

    // Invitations: the invitee (by verified email; stored lowercase) and the
    // org's managers. List queries must filter on email or on orgId.
    match /orgInvitations/{invitationId} {
      allow read: if request.auth != null && (
        (request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower())
        || isOrgManager(resource.data.orgId));
      allow write: if false;
    }

    // The user's orgs ({ orgs: { [orgId]: role } }), maintained by orgs.js.
    match /userOrgs/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Social Profile Collection Rules (PUBLIC data - usernames, display info, etc.)
    match /socialProfile/{userId} {
      // Allow any authenticated user to read (for username lookups, public profiles)
      allow read: if request.auth != null;

      // Users can only create their own profile (doc ID must match auth UID)
      allow create: if request.auth != null
        && request.auth.uid == userId  // Doc ID must match auth UID
        && request.resource.data.userId == userId; // userId field must match too

      // Users can only update their own profile
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Token Profile Collection Rules (PRIVATE data - token counts, usage, etc.)
    match /tokenProfile/{userId} {
      // Users can only read their own token profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow users to create their initial token profile with default token counts
      allow create: if request.auth != null
        && request.auth.uid == userId  // Doc ID must match auth UID
        && request.resource.data.userId == userId  // userId field must match
        && request.resource.data.geoToken == 3  // Must start with exactly 3 geo tokens
        && request.resource.data.genToken == 5  // Must start with exactly 5 image tokens (allows one 4x render)
        // Exactly the fields getTokenProfile (src/shared/utils/tokens.js)
        // writes — in particular never `proUntil`, which grants Pro (#1922).
        && request.resource.data.keys().hasOnly([
          'userId', 'geoToken', 'genToken', 'createdAt', 'updatedAt', 'lastMonthlyRefill'
        ]);

      // DENY all client-side updates - only cloud functions can modify token counts
      allow update: if false;
    }

    // Gallery Assets Subcollection Rules
    // Structure: users/{userId}/assets/{assetId}
    //
    // Visibility model (forward-compatible enum, not a boolean):
    //   'public'   — readable by anyone; appears in listing/search queries
    //   'unlisted' — readable by anyone with the assetId; hidden from listings
    //   'private'  — readable by owner only
    // Today every new asset is created 'public'. The privacy toggle UI will
    // ship later; this rule shape is in place so flipping the field is the
    // only change required at that point.
    //
    // Legacy docs without a visibility field default to 'public' via .get()
    // so the rule remains backwards-compatible during rollout.
    match /users/{userId}/assets/{assetId} {
      // Read: owner always, or anyone if the asset is public/unlisted.
      allow read: if (request.auth != null && request.auth.uid == userId)
        || resource.data.get('visibility', 'public') in ['public', 'unlisted'];

      // Users can create assets with proper userId field and required fields validated.
      // visibility must be one of the allowed enum values when present; absent
      // is allowed for backwards compatibility (treated as 'public' on read).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.type in ['image', 'video', 'splat', 'mesh']
        && request.resource.data.category is string
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^users/' + userId + '/.*')
        && (!('visibility' in request.resource.data.keys())
            || request.resource.data.visibility in ['public', 'unlisted', 'private']);

      // Users can update their own assets, but cannot mutate quota-relevant
      // or identity fields after create. `size` in particular feeds the
      // onAssetWritten trigger that maintains users/{uid}/meta/usage.bytesUsed
      // — letting clients rewrite it would let them spoof their storage usage.
      // Long-term, `size` should be set server-side from the actual Storage
      // object; this rule is the short-term guard.
      //
      // The optimized-variant fields (optimizedSourcePath / optimizedSourceSize)
      // are deliberately NOT frozen: the "Reoptimize" action re-runs the client
      // optimization pipeline over the original and repoints the doc at a new
      // optimized file. Neither field can be used to spoof quota — the tally
      // reads `size` only and asset-quota.js explicitly excludes
      // optimizedSourceSize as a platform-derived artifact. The old optimized
      // object is left unreferenced and reclaimed by the monthly
      // cleanupOrphanedStorage job once the asset is purged. optimizedSourcePath
      // is constrained to the user's own folder so a client can't repoint the
      // doc at another user's bytes and keep them alive. (The create rule does
      // not check this field; a bad reference there only pins a Storage
      // object against the orphan GC, it grants no access.)
      //
      // Uses diff().affectedKeys() so legacy docs missing optional fields
      // (e.g. AI-generated images without optimizedSourceSize) update cleanly:
      // a field absent from both before and after never appears in affectedKeys.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['size', 'storagePath', 'userId'])
        // Only validated when actually changed, so an untouched legacy value
        // can never block an unrelated update (e.g. a soft delete). Removing
        // the field is allowed: "Remove optimized" reverses a lossy
        // optimization by dropping the variant fields so the original is
        // served again (removeOptimizedVariant). A null is still denied —
        // `is string` fails on it rather than erroring the rule. The second
        // pattern rejects any `..` path segment, which the prefix check alone
        // would let through (`users/<uid>/../elsewhere.glb`) — storage.rules
        // already stops the client writing there, but such a reference would
        // keep a file the orphan GC should have reclaimed alive and skew its
        // audit.
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['optimizedSourcePath'])
            || !('optimizedSourcePath' in request.resource.data)
            || (request.resource.data.optimizedSourcePath is string
                && request.resource.data.optimizedSourcePath
                    .matches('^users/' + userId + '/.*')
                && !request.resource.data.optimizedSourcePath
                    .matches('.*/[.][.](/.*)?')))
        // visibility is mutable (privacy toggle, future feature) but must
        // remain a valid enum value when present.
        && (!('visibility' in request.resource.data.keys())
            || request.resource.data.visibility in ['public', 'unlisted', 'private']);

      // Hard delete is disallowed for clients. The UI calls `updateDoc` with
      // `deleted: true` (soft delete); the GC Cloud Function performs the
      // eventual hard delete via Admin SDK (bypasses these rules).
    }

    // Notify Log Collection Rules (PRIVATE - cloud functions only)
    // Tracks notification sends to prevent duplicates; no client access allowed
    match /notifyLog/{userId} {
      allow read, write: if false;
    }

    // Lifecycle email log (PRIVATE - cloud functions only)
    // Summary doc backs stop-rules (once-ever, cooldowns, dedupe keys);
    // sends subcollection is the append-only audit of every attempted send.
    // See public/functions/email/lifecycle-email.js.
    match /emailLog/{userId} {
      allow read, write: if false;
      match /sends/{sendId} {
        allow read, write: if false;
      }
    }

    // Email preferences / suppression (PRIVATE - cloud functions only)
    // Per-stream opt-out state mirrored from Postmark's Subscription Change
    // webhook (postmarkSubscriptionWebhook); checked before broadcast sends.
    match /emailPrefs/{userId} {
      allow read, write: if false;
    }

    // Stripe checkout trigger records (PRIVATE - cloud functions only)
    // Written by createStripeSession / stripeWebhook; scanned by the
    // abandoned-checkout lifecycle email sweep. Clients must never touch
    // these — a spoofed record would trigger emails to arbitrary users.
    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // User behavior signals for lifecycle emails (email/lifecycle-sweeps.js).
    // The ONLY field a client may write is its own lastPaymentModalAt, and
    // only with the server's clock — enough for the pricing-page nudge,
    // useless for forging anyone else's state. lastCheckoutStartedAt is
    // written server-side by createStripeSession (Admin SDK bypasses rules).
    match /userSignals/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'lastPaymentModalAt'])
        && request.resource.data.userId == userId
        && request.resource.data.lastPaymentModalAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userId', 'lastPaymentModalAt'])
        && request.resource.data.userId == userId
        && request.resource.data.lastPaymentModalAt == request.time;
      allow delete: if false;
    }

    // Asset usage doc (PRIVATE - cloud functions write, owner reads)
    // Maintained by onAssetWritten trigger; read by getUploadQuota and the
    // Assets panel storage meter.
    match /users/{userId}/meta/usage {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Generation job queue
    // Async AI generation jobs (image→splat today; image/video/photogrammetry
    // later). WRITES are Admin-SDK only (the submit / poll / webhook / reconciler
    // functions): clients must never write status, token, or provider fields —
    // that would let them spoof a charge/refund or a result.
    //
    // READS are allowed to the owner of the job so the gallery can show
    // in-flight jobs as pending cards (surviving reload / across tabs) via a live
    // listener. The doc holds a per-job webhookSecret, but exposing it to the
    // *owner* is safe: it gates the public webhook against forged POSTs for
    // someone else's job, and a third party still can't read this doc (read is
    // uid-scoped), so the secret stays confidential from attackers. The worst an
    // owner can do with their own secret is re-trigger idempotent processing of
    // their own job — already possible via getGenerationJobStatus.
    // (Rules don't cascade, so this is also belt-and-suspenders against any
    // future broad users/{uid} rule.)
    match /users/{userId}/generationJobs/{jobId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Project Pass codes (#1922). Minted by scripts/mint-pass-codes.js and
    // redeemed only through the redeemPassCode callable (Admin SDK, bypasses
    // rules). Clients must never read codes (that would leak every code) or
    // write redemptions (that would grant Pro), so both are fully closed.
    match /passCodes/{code} {
      allow read, write: if false;
    }
    match /passRedemptions/{redemptionId} {
      allow read, write: if false;
    }

    // Background-job health heartbeats (System Health admin page).
    // Each scheduled function records its last run + status here via the Admin
    // SDK (writes bypass rules). Admin-only read; never client-writable.
    match /jobHealth/{jobName} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
